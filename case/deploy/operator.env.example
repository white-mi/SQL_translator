# Operator settings of the SQLTR campaign on one VM. Copy to /etc/sqltr-arena/operator.env (outside git),
# fill the values, chmod 600. Read by case/deploy/arena.sh; never mounted into the researcher container.

# --- pinned arena checkout with its venv (ADR 0001) and the sqltr checkout
ARENA_DIR=/opt/arena
SQLTR_DIR=/opt/sqltr
ROOT=/srv/sqltr-arena

# --- campaign conditions (ADR 0006; final values after the supervisor's answers)
CAMPAIGN_ID=sqltr-c1
MAX_SOLUTIONS=50
FINALISTS=5
OUTPUT_COUNT=3
RELEASE_ID=sqltr-c1-metric-v1-runner-1
CONDITIONS_ID=sqltr-metric-v1-runner-1
TRAIN_DATASET_ID=train-20261101-250
RUNNER_IMAGE=sqltr-runner:1

# --- where the evaluators listen: the gateway IP of the docker network the researcher container joins
LISTEN_HOST=172.30.0.1
TRAIN_PORT=8091
PUBLIC_PORT=8092
PRIVATE_PORT=8093
EXECUTION_SLOTS=2

# --- engines of the measurement stand (stand/compose.yaml publishes them on 127.0.0.1)
SQLTR_PG_HOST=127.0.0.1
SQLTR_PG_PORT=5432
SQLTR_TRINO_HOST=127.0.0.1
SQLTR_TRINO_PORT=8080
# passwords: same values as stand/.env
SQLTR_PG_ADMIN_PASSWORD=
SQLTR_PG_RUNNER_PASSWORD=
